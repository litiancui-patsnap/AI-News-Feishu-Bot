# Default model backend: use LiteLLM's OpenAI-compatible endpoint.
LLM_PROVIDER=litellm

# LiteLLM / OpenAI-compatible configuration
OPENAI_BASE_URL=http://192.168.106.73:4000/v1
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_GENERAL_MODEL=gpt-5.4
OPENAI_CODING_MODEL=gpt-5.4-codex
OPENAI_TEMPERATURE=0.2
OPENAI_MODEL_TOKENS=128000

# Keep the Ollama entry so local models remain available.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral-nemo:latest
OLLAMA_TEMPERATURE=0.7
OLLAMA_MODEL_TOKENS=128000

# Feishu webhook URL (required)
FEISHU_WEBHOOK_URL=your_webhook_url_here

# Feishu app credentials for image upload (required when uploading images)
FEISHU_APP_ID=your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here

# Number of news items pushed each day
MAX_NEWS_ITEMS=3

# Search query for daily news discovery. Use | to separate topic groups.
SEARCH_QUERY=绿化养护 | 园林绿化 | 城市绿化 | 市政养护 绿化 | 养护标准 绿化 | 绿化招标 | 智慧园林 | 智能灌溉 | 园林机械 | 3DJS WebGL 空间 | Three.js GIS 空间 | 空间大模型 | 数字孪生 三维重建
SEARCH_REGION=cn-zh
SEARCH_TIME_LIMIT=w
NEWS_MAX_AGE_HOURS=48

# Daily push time
PUSH_TIME=9:50

# Infographic generation
ENABLE_INFOGRAPHIC=false
INFOGRAPHIC_OUTPUT_DIR=./images/generated
INFOGRAPHIC_API_FALLBACK=false
