# 飞书 Webhook URL (必填)
FEISHU_WEBHOOK_URL=your_webhook_url_here

# 飞书应用凭证（用于上传图片，必填）
FEISHU_APP_ID=your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here

# 每日推送资讯数量 (可选,默认3条)
MAX_NEWS_ITEMS=3

# 搜索关键词 (可选,默认见下方)
# 优化后的关键词：聚焦主要AI公司和模型发布
# 包含：OpenAI、Google、Meta、Anthropic等主流公司
SEARCH_QUERY=OpenAI Google Meta Anthropic AI model launch release 2026

# 定时推送时间 (可选,默认9:50)
PUSH_TIME=9:50

# 图片生成配置
# 是否启用信息图生成 (true/false，默认false)
# 注意：需要配置可用的 Gemini 图片生成 API
ENABLE_INFOGRAPHIC=false

# 信息图输出目录 (可选,默认./images/generated)
INFOGRAPHIC_OUTPUT_DIR=./images/generated
